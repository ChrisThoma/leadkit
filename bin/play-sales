#!/usr/bin/env python3
"""Daily Google Play sales by app, from the Play Console's monthly sales reports.

The Android side of asc-sales. Play writes an estimated sales report per month into
the developer account's Cloud Storage bucket and adds to it as orders come in, so the
last few days fill in a day or so late, as in Play Console's Orders page.

    play-sales                  # the last 7 days, every app
    play-sales --days 14 --app Proofer
    play-sales --tsv            # tab-separated, for metrics.tsv

Only charged orders count; a refunded or charged-back order is left out (its
"Charged" row stays in the report beside the "Refund" one). Amounts are what the
buyer paid, before Google's fee and tax, in the buyer's currency, so the amount column
lists each currency separately. The --tsv output adds a proceeds column: the item price
before tax less Google's 15% fee (the "First USD 1M" tier), in
dollars at the day's rates (the same cache asc-sales keeps), then a sales column: the
item price before the fee, in dollars the same way.

Settings come from the environment, falling back to ~/.config/play-sales/config.json
(keys: bucket, service_account):
  PLAY_BUCKET            Play Console > Download reports > Financial > Copy Cloud
                         Storage URI, without gs:// or the folder
  PLAY_SERVICE_ACCOUNT   service account key, default ~/.config/google-play/publisher.json.
                         It needs the account permission "View financial data, orders,
                         and cancellation survey responses".
"""

import argparse
import csv
import io
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from collections import defaultdict
from datetime import date, timedelta
from pathlib import Path

import jwt

CONFIG_FILE = Path.home() / ".config" / "play-sales" / "config.json"
DEFAULT_KEY = Path.home() / ".config" / "google-play" / "publisher.json"
RATES_FILE = Path.home() / ".cache" / "asc-sales" / "rates.json"
RATES_URL = "https://open.er-api.com/v6/latest/USD"
FEE = 0.15


def setting(env, key, config, default=None):
    value = os.environ.get(env) or config.get(key) or default
    if not value:
        sys.exit(f"Missing {env}. Set it, or add \"{key}\" to {CONFIG_FILE}.")
    return value


def token(key_file):
    account = json.loads(Path(key_file).expanduser().read_text())
    now = int(time.time())
    assertion = jwt.encode(
        {"iss": account["client_email"], "aud": "https://oauth2.googleapis.com/token",
         "scope": "https://www.googleapis.com/auth/devstorage.read_only",
         "iat": now, "exp": now + 600},
        account["private_key"], algorithm="RS256",
    )
    body = urllib.parse.urlencode({
        "grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer", "assertion": assertion,
    }).encode()
    with urllib.request.urlopen("https://oauth2.googleapis.com/token", body, timeout=60) as resp:
        return json.load(resp)["access_token"]


def month_report(bucket, month, auth):
    """Rows of the sales report for `month` (YYYYMM), or [] if Play has none yet."""
    name = urllib.parse.quote(f"sales/salesreport_{month}.zip", safe="")
    req = urllib.request.Request(
        f"https://storage.googleapis.com/storage/v1/b/{bucket}/o/{name}?alt=media",
        headers={"Authorization": f"Bearer {auth}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as err:
        if err.code == 404:
            return []
        detail = err.read().decode("utf-8", "replace")[:300]
        if err.code == 403:
            detail += ("\nGive the service account \"View financial data\" in Play Console >"
                       " Users and permissions. It can take hours to reach the bucket.")
        sys.exit(f"{month}: HTTP {err.code} {detail}")
    with zipfile.ZipFile(io.BytesIO(raw)) as archive:
        text = archive.read(archive.namelist()[0]).decode("utf-8-sig")
    return list(csv.DictReader(io.StringIO(text)))


def report_updated(bucket, month, auth):
    """When Google last rewrote the month's sales report (ISO UTC), or "" if there's none."""
    name = urllib.parse.quote(f"sales/salesreport_{month}.zip", safe="")
    req = urllib.request.Request(f"https://storage.googleapis.com/storage/v1/b/{bucket}/o/{name}",
                                 headers={"Authorization": f"Bearer {auth}"})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            return json.load(resp).get("updated", "")
    except urllib.error.HTTPError:
        return ""


def amount(text):
    text = (text or "0").strip()
    # "2,37" is a decimal comma; "1,299.00" has a thousands comma.
    if "," in text and "." not in text and len(text.rsplit(",", 1)[1]) == 2:
        return float(text.replace(",", "."))
    return float(text.replace(",", ""))


def refunded(rows):
    """Order numbers refunded or charged back. Their "Charged" row stays in the report."""
    return {r.get("Order Number") for r in rows if r.get("Financial Status", "").lower() not in ("charged", "")}


def summarize(rows, days, app=None):
    """{(day, title): totals} for charged orders on `days`, less refunded ones."""
    wanted, gone = {d.isoformat() for d in days}, refunded(rows)
    totals = defaultdict(lambda: {"units": 0, "charged": defaultdict(float), "net": defaultdict(float), "gross": defaultdict(float),
                                  "countries": set(), "kind": set()})
    for row in rows:
        day = row.get("Order Charged Date", "")
        if day not in wanted or row.get("Financial Status", "").lower() != "charged" or row.get("Order Number") in gone:
            continue
        title = row.get("Product Title") or row.get("Product ID") or "?"
        if app and app.lower() not in title.lower():
            continue
        t = totals[(date.fromisoformat(day), title)]
        t["units"] += 1
        t["charged"][row.get("Currency of Sale", "")] += amount(row.get("Charged Amount"))
        t["net"][row.get("Currency of Sale", "")] += amount(row.get("Item Price")) * (1 - FEE)
        t["gross"][row.get("Currency of Sale", "")] += amount(row.get("Item Price"))
        t["countries"].add(row.get("Country of Buyer", ""))
        t["kind"].add("iap" if row.get("Product Type", "").lower() == "inapp" else "app")
    return totals


def usd_rates():
    """Units of each currency per dollar, fetched once a day. None if it can't be had."""
    today = date.today().isoformat()
    try:
        cached = json.loads(RATES_FILE.read_text())
        if cached.get("date") == today:
            return cached["rates"]
    except (OSError, ValueError, KeyError):
        pass
    try:
        with urllib.request.urlopen(RATES_URL, timeout=15) as resp:
            rates = json.load(resp)["rates"]
    except (OSError, ValueError, KeyError):
        return None
    RATES_FILE.parent.mkdir(parents=True, exist_ok=True)
    RATES_FILE.write_text(json.dumps({"date": today, "rates": rates}))
    return rates


def dollars(by_currency, rates):
    """The dollar total; a currency with no rate is left out."""
    total = 0.0
    for currency, value in by_currency.items():
        if currency in ("", "USD"):
            total += value
        elif rates and rates.get(currency):
            total += value / rates[currency]
    return total


def orders(rows, since, rates):
    """Charged orders at or after `since` (Unix seconds), oldest first, for the live view:
    {"at": ISO UTC, "title", "kind", "sales": customer price with tax in dollars}."""
    out, gone = [], refunded(rows)
    for row in rows:
        if row.get("Order Number") in gone:
            continue
        try:
            at = int(row.get("Order Charged Timestamp") or 0)
        except ValueError:
            continue
        if at < since or row.get("Financial Status", "").lower() != "charged":
            continue
        cur = row.get("Currency of Sale", "")
        out.append({"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(at)),
                    "title": row.get("Product Title") or row.get("Product ID") or "?",
                    "kind": "iap" if row.get("Product Type", "").lower() == "inapp" else "app",
                    "sales": round(dollars({cur: amount(row.get("Charged Amount"))}, rates), 2)})
    return sorted(out, key=lambda o: o["at"])


def ratings_from(rows):
    """{package: {"avg", "count"}} from the reviews export's rows. The export holds every
    star rating, with text or without; a review edited in a later month shows up in both
    months' files, so each reviewer (device and first submit time) counts once, at their
    newest stars."""
    newest = {}
    for r in rows:
        key = (r["Package Name"], r.get("Device", ""), r.get("Review Submit Millis Since Epoch", ""))
        at = int(r.get("Review Last Update Millis Since Epoch") or 0)
        if key not in newest or at >= newest[key][0]:
            newest[key] = (at, int(r["Star Rating"]))
    by = defaultdict(list)
    for (pkg, _, _), (_, stars) in newest.items():
        by[pkg].append(stars)
    return {pkg: {"avg": round(sum(v) / len(v), 2), "count": len(v)} for pkg, v in sorted(by.items())}


def review_rows(bucket, auth):
    """Every row of every reviews/ file in the bucket (Play writes them UTF-16)."""
    url = (f"https://storage.googleapis.com/storage/v1/b/{bucket}/o?prefix=reviews%2F"
           "&fields=items(name),nextPageToken")
    names, page = [], ""
    while True:
        req = urllib.request.Request(url + (f"&pageToken={page}" if page else ""), headers={"Authorization": f"Bearer {auth}"})
        with urllib.request.urlopen(req, timeout=60) as resp:
            got = json.load(resp)
        names += [i["name"] for i in got.get("items", []) if i["name"].endswith(".csv")]
        page = got.get("nextPageToken")
        if not page:
            break
    rows = []
    for name in names:
        req = urllib.request.Request(
            f"https://storage.googleapis.com/storage/v1/b/{bucket}/o/{urllib.parse.quote(name, safe='')}?alt=media",
            headers={"Authorization": f"Bearer {auth}"})
        with urllib.request.urlopen(req, timeout=60) as resp:
            rows += list(csv.DictReader(io.StringIO(resp.read().decode("utf-16"))))
    return rows


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--days", type=int, default=7, help="How many days back (default 7).")
    parser.add_argument("--app", help="Only titles containing this (case-insensitive).")
    parser.add_argument("--tsv", action="store_true", help="Print tab-separated rows.")
    parser.add_argument("--orders", type=int, metavar="HOURS",
                        help="Print the charged orders of the last HOURS as JSON, one per order with its time, and when the report was last updated.")
    parser.add_argument("--ratings", action="store_true",
                        help="Print each app's Play star rating and count as JSON, from the reviews export.")
    args = parser.parse_args()

    config = json.loads(CONFIG_FILE.read_text()) if CONFIG_FILE.exists() else {}
    bucket = setting("PLAY_BUCKET", "bucket", config)
    auth = token(setting("PLAY_SERVICE_ACCOUNT", "service_account", config, str(DEFAULT_KEY)))

    if args.ratings:
        print(json.dumps(ratings_from(review_rows(bucket, auth))))
        return

    if args.orders:
        since = int(time.time()) - args.orders * 3600
        months = sorted({time.strftime("%Y%m", time.gmtime(t)) for t in (since, time.time())})
        rows = [r for m in months for r in month_report(bucket, m, auth)]
        # The report is rewritten a few times a day; orders after `updated` aren't in it yet.
        print(json.dumps({"updated": report_updated(bucket, months[-1], auth), "orders": orders(rows, since, usd_rates())}))
        return

    # Same window as asc-sales, so the two line up by day.
    end = date.today() - timedelta(days=1)
    days = [end - timedelta(days=i) for i in range(args.days)][::-1]

    rows = []
    for month in sorted({d.strftime("%Y%m") for d in days}):
        rows += month_report(bucket, month, auth)
    totals = summarize(rows, days, args.app)

    if args.tsv:
        print("date\ttitle\tkind\tunits\tcharged\tcountries\tproceeds\tsales")
        rates = usd_rates() if any((set(t["net"]) | set(t["gross"])) - {"", "USD"} for t in totals.values()) else None
    elif not totals:
        print(f"No sales from {days[0]} to {days[-1]}.")
    for (day, title), t in sorted(totals.items()):
        countries = ",".join(sorted(c for c in t["countries"] if c))
        kind = "+".join(sorted(t["kind"]))
        charged = ",".join(f"{v:.2f} {c}".strip() for c, v in sorted(t["charged"].items()))
        if args.tsv:
            print(f"{day}\t{title}\t{kind}\t{t['units']}\t{charged}\t{countries}\t{dollars(t['net'], rates):.2f}\t{dollars(t['gross'], rates):.2f}")
        else:
            print(f"{day}  {title:<40} {kind:<7} {t['units']:>3}  {charged:>12}  {countries}")


if __name__ == "__main__":
    main()
